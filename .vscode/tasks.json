{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compilar Java a bin",
            "type": "shell",
            "command": "javac",
            "args": [
                "-encoding",
                "UTF-8",
                "-d",
                "bin",
                "-sourcepath",
                "src",
                "src/**/*.java"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$javac"]
        }
    ]
}